---
import "../../styles/painel.css";

// ícones de traço, desenhados pra cada aba (24×24)
const ABAS: [string, string, string][] = [
  ["inicio", "Início", '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>'],
  ["catalogo", "Catálogo", '<path d="M9 18V6l11-2v12"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>'],
  ["novidades", "Novidades", '<path d="m12 3 2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/>'],
  ["banner", "Banner", '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="m3 16 5-5 4 4 3-3 6 6"/><circle cx="16" cy="9" r="1.6"/>'],
  ["festa", "Festa", '<path d="M4 21 9 6l9 9z"/><path d="M14 3c0 2 2 2 2 4M19 8c1 0 2-1 2-2M17 12c1.5 0 3 .5 4 2"/>'],
  ["contato", "Contato", '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/>'],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Painel · Ari Ribeiro Karaokê</title>
    <meta name="theme-color" content="#0f6b36" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Instrument+Serif:ital@0;1&family=Schibsted+Grotesk:wght@400;500;700;800&family=Space+Mono:wght@400;700&display=swap" />
  </head>
  <body>
    <div class="app">
      <aside class="lado">
        <a class="marca" href="/" target="_blank" rel="noopener" title="Abrir o site">
          <img src="/img/logo-redonda.webp" width="40" height="40" alt="" />
          <span><b>Ari Ribeiro</b><em>painel</em></span>
        </a>
        <nav class="abas" aria-label="Telas do painel">
          {ABAS.map(([id, nome, icone]) => (
            <a href={`#${id}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icone} /><span>{nome}</span></a>
          ))}
        </nav>
        <div class="quem">
          <p class="quem-txt"><span class="quem-rot">Entrou como</span> <b id="email">…</b></p>
          <!-- logout do Cloudflare Access: encerra a sessão e volta pro pedido de e-mail -->
          <a class="sair" href="/cdn-cgi/access/logout"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h5v16h-5"/><path d="M10 8l-4 4 4 4"/><path d="M6 12h10"/></svg>Sair</a>
        </div>
      </aside>
      <div class="conteudo">
        <div class="status" id="status" data-tipo="carregando" role="status" aria-live="polite">
          <span class="luz" aria-hidden="true"></span><span class="txt">Carregando…</span>
        </div>
        <main id="tela" tabindex="-1"><p class="carregando">Carregando o painel…</p></main>
      </div>
    </div>
    <div class="aviso" id="aviso" role="status" aria-live="polite"></div>
    <script>
      import "../../scripts/painel/main.ts";
    </script>
  </body>
</html>
