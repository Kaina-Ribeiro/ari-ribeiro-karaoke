{
  "name": "ari-ribeiro-karaoke",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "planilha": "node scripts/planilha.ts",
    "planilha:offline": "node scripts/planilha.ts --offline",
    "dev": "pnpm planilha && astro dev",
    "build": "pnpm planilha && astro build",
    "build:offline": "pnpm planilha:offline && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "dev:offline": "pnpm planilha:offline && astro dev",
    "e2e": "playwright test",
    "build:painel-local": "node --env-file=.dev.vars scripts/planilha.ts && astro build",
    "painel": "node scripts/painel-local.ts",
    "importa": "node scripts/importa.ts",
    "prints": "node scripts/prints.ts",
    "segredos:preview": "node scripts/segredos-preview.ts"
  },
  "dependencies": {
    "astro": "7.3.8",
    "jose": "6.2.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
